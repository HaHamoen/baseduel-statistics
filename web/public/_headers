# Data changes after every match: revalidate each time (a 304 is cheap).
/data/*
  Cache-Control: no-cache

# Built files are named by their content, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The display font: a new version would get a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
